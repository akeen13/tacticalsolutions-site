---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPovPosts } from '../../lib/pov';
import { withBase } from '../../lib/urls';

export async function getStaticPaths() {
  const posts = await getPovPosts();
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// CTA hrefs can be internal paths, absolute URLs or mailto. Only internal
// paths need the base prefix; query strings and fragments must survive.
const ctaHref = (() => {
  const raw = post.data.cta?.href;
  if (!raw || /^(?:[a-z]+:|\/\/)/i.test(raw)) return raw;
  const [path, ...rest] = raw.split('?');
  const query = rest.length ? `?${rest.join('?')}` : '';
  return `${withBase(path)}${query}`;
})();

const fmt = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  canonicalPath={`/pov/${post.data.slug}`}
>
  <article>
    <h1>{post.data.title}</h1>
    <div class="meta">
      {fmt} &middot; {post.data.proofArm}
      {' '} &middot; {post.data.author}
      {post.data.draft && <span class="tag">Draft</span>}
    </div>

    <Content />

    {
      post.data.cta && (
        <div class="cta">
          <a href={ctaHref}>{post.data.cta.label}</a>
        </div>
      )
    }
  </article>
</BaseLayout>
