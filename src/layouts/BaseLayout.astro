---
import { withBase } from '../lib/urls';

interface NavLink {
  label: string;
  href: string;
  anchor?: boolean;
}

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  /** Wordmark text. Defaults to the company name. */
  brandLabel?: string;
  /** Where the wordmark points. Defaults to the site root. */
  brandHref?: string;
  /** Header links. Defaults to the root nav (POV). */
  navLinks?: NavLink[];
  /** Optional header CTA rendered at the end of the nav. */
  navCta?: NavLink;
  /** Widen the content column for editorial/marketing pages. */
  wide?: boolean;
  /** Add `.prose` wrapper styling hooks. */
  bodyClass?: string;
}

const {
  title,
  description,
  canonicalPath,
  brandLabel = 'Tactical Solutions',
  brandHref = '/',
  navLinks = [
    { label: 'Weft', href: '/weft' },
    { label: 'ProSentinel', href: '/prosentinel' },
    { label: 'Applied', href: '/applied' },
    { label: 'POV', href: '/pov' },
  ],
  navCta,
  wide = false,
  bodyClass,
} = Astro.props;
const siteName = 'Tactical Solutions';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = canonicalPath
  ? new URL(withBase(canonicalPath), Astro.site).toString()
  : Astro.url.toString();

// Internal links get the base prefix; absolute URLs, mailto and bare
// in-page anchors pass through unchanged.
const href = (link: NavLink) =>
  /^(?:[a-z]+:|\/\/|#)/i.test(link.href) ? link.href : withBase(link.href);

// Page analytics (Plausible, cookieless). One tag in <head>, so every page
// counts with no per-page work and no cookie banner.
//
// The data-domain is pinned to the canonical domain rather than read from the
// deploy host, so the interim GitHub Pages host and the eventual custom domain
// report into one continuous series instead of splitting into two site entries.
// Override with PUBLIC_PLAUSIBLE_DOMAIN if that ever needs to move.
//
// Skipped in dev so `astro dev` refreshes do not inflate the live numbers.
// PUBLIC_PLAUSIBLE_SRC points at a self-hosted Plausible.
const plausibleDomain =
  import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN ?? 'tacticalsolutions.com';
const plausibleScript =
  import.meta.env.PUBLIC_PLAUSIBLE_SRC ?? 'https://plausible.io/js/script.js';
const showAnalytics = import.meta.env.PROD;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Tactical Solutions POV"
      href={withBase('/pov/rss.xml')}
    />
    {
      showAnalytics && (
        <script
          is:inline
          defer
          data-domain={plausibleDomain}
          src={plausibleScript}
        />
      )
    }
  </head>
  <body class={bodyClass}>
    <header>
      <nav class={wide ? 'wide' : undefined}>
        <a href={href({ label: brandLabel, href: brandHref })} class="brand">{brandLabel}</a>
        {
          navLinks.map((link) => (
            <a href={href(link)}>{link.label}</a>
          ))
        }
        {
          navCta && (
            <a href={href(navCta)} class="nav-cta">
              {navCta.label}
            </a>
          )
        }
      </nav>
    </header>
    <main class={wide ? 'wide' : undefined}>
      <slot />
    </main>
    <footer>
      <slot name="footer">
        <div class="site-footer">
          <p class="footer-brand">Tactical Solutions</p>
          <nav class="footer-links" aria-label="Footer">
            <a href={withBase('/weft')}>Weft PocketQS</a>
            <a href={withBase('/prosentinel')}>ProSentinel</a>
            <a href={withBase('/applied')}>Applied</a>
            <a href={withBase('/pov')}>POV</a>
          </nav>
          <p class="small-print">&copy; {new Date().getFullYear()} Tactical Solutions.</p>
        </div>
      </slot>
    </footer>
    <style is:global>
      :root {
        --fg: #111;
        --fg-muted: #555;
        --bg: #fff;
        --accent: #1a1a1a;
        --rule: #e5e5e5;
        --max: 72ch;
        font-size: 17px;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        line-height: 1.55;
      }
      a { color: var(--accent); }
      header {
        border-bottom: 1px solid var(--rule);
      }
      header nav {
        max-width: var(--max);
        margin: 0 auto;
        padding: 1rem 1.25rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem 1.25rem;
        align-items: baseline;
      }
      header nav .brand {
        font-weight: 600;
        letter-spacing: -0.01em;
        margin-right: auto;
      }
      header nav a {
        text-decoration: none;
        /* Comfortable tap target on a shop-floor phone. */
        padding: 0.35rem 0;
        min-height: 1.9rem;
        display: inline-flex;
        align-items: center;
      }
      header nav a:hover { text-decoration: underline; }
      /* Narrow screens: the header links do not fit on one line, so let the
         nav wrap and drop the brand onto its own row. */
      @media (max-width: 40rem) {
        header nav {
          flex-wrap: wrap;
          gap: 0.5rem 1rem;
          padding: 0.85rem 1rem;
        }
        header nav .brand {
          flex-basis: 100%;
          margin-right: 0;
        }
        header nav .nav-cta { margin-left: auto; }
      }
      header nav .nav-cta {
        border: 1px solid var(--accent);
        border-radius: 3px;
        padding: 0.35rem 0.85rem;
        white-space: nowrap;
      }
      header nav .nav-cta:hover {
        background: var(--accent);
        color: var(--bg);
        text-decoration: none;
      }
      main {
        max-width: var(--max);
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
      }
      /* Wide variant for marketing/editorial pages. */
      .wide {
        max-width: 60rem;
      }
      main.wide > section + section {
        margin-top: 4rem;
      }
      /* Shared section primitives. */
      .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.75rem;
        color: var(--fg-muted);
        margin: 0 0 0.75rem;
      }
      .lede {
        font-size: 1.1875rem;
        color: var(--fg-muted);
        max-width: 60ch;
      }
      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.25rem;
        align-items: center;
        margin-top: 1.5rem;
      }
      .btn {
        display: inline-block;
        border: 1px solid var(--accent);
        border-radius: 3px;
        padding: 0.6rem 1.1rem;
        font-weight: 600;
        text-decoration: none;
      }
      .btn:hover {
        background: var(--accent);
        color: var(--bg);
      }
      .btn.secondary {
        border-color: var(--rule);
        font-weight: 500;
      }
      .btn.secondary:hover {
        background: #f2f2f2;
        color: var(--fg);
      }
      .card-grid {
        display: grid;
        gap: 1.75rem;
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        margin-top: 1.5rem;
      }
      .card {
        border-top: 2px solid var(--accent);
        padding-top: 0.85rem;
      }
      .card h3 {
        font-size: 1.0625rem;
        margin: 0 0 0.4rem;
      }
      .card p { margin: 0; color: var(--fg-muted); }
      .rule-list {
        padding-left: 1.1rem;
        max-width: 60ch;
      }
      .rule-list li { margin-bottom: 0.5rem; }
      footer {
        border-top: 1px solid var(--rule);
        color: var(--fg-muted);
        font-size: 0.875rem;
      }
      footer p {
        max-width: var(--max);
        margin: 0 auto;
        padding: 1.25rem;
      }
      .site-footer {
        max-width: var(--max);
        margin: 0 auto;
        padding: 1.25rem;
      }
      .site-footer p { padding: 0; }
      .footer-brand {
        margin: 0 0 0.6rem;
        font-weight: 600;
        color: var(--fg);
      }
      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.25rem;
        margin-bottom: 0.9rem;
      }
      .footer-links a { text-decoration: none; }
      .footer-links a:hover { text-decoration: underline; }
      .small-print { margin: 0; max-width: 60ch; }
      h1, h2, h3 { letter-spacing: -0.015em; line-height: 1.2; }
      h1 { font-size: 2rem; margin: 0 0 0.5rem; }
      h2 { font-size: 1.5rem; margin-top: 2rem; }
      article p, article li { font-size: 1.0625rem; }
      article pre {
        background: #fafafa;
        border: 1px solid var(--rule);
        padding: 1rem;
        overflow-x: auto;
        font-size: 0.9rem;
      }
      article code { font-size: 0.95em; }
      .meta {
        color: var(--fg-muted);
        font-size: 0.9rem;
        margin-bottom: 2rem;
      }
      .post-list { list-style: none; padding: 0; margin: 0; }
      .post-list li {
        padding: 1.25rem 0;
        border-bottom: 1px solid var(--rule);
      }
      .post-list li:last-child { border-bottom: none; }
      .post-list h2 { font-size: 1.25rem; margin: 0 0 0.25rem; }
      .post-list h2 a { text-decoration: none; }
      .post-list h2 a:hover { text-decoration: underline; }
      .post-list .post-meta {
        color: var(--fg-muted);
        font-size: 0.875rem;
        margin-bottom: 0.5rem;
      }
      .tag {
        display: inline-block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--fg-muted);
        border: 1px solid var(--rule);
        padding: 0.1rem 0.5rem;
        border-radius: 2px;
        margin-left: 0.5rem;
      }
      .cta {
        margin-top: 3rem;
        padding: 1.25rem;
        border-left: 3px solid var(--accent);
        background: #fafafa;
      }
      .cta a {
        font-weight: 600;
      }
    </style>
  </body>
</html>
